<Window x:Class="TimersApp.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TimersApp.Desktop" Style="{StaticResource {x:Type Window}}" Title="Tommy’s Time Tracking Tables" Width="1220" Height="820" MinWidth="680" MinHeight="480" WindowStartupLocation="CenterScreen">
  <Grid x:Name="Root">
  <local:ImageBackdrop x:Name="AppBackdrop" IsHitTestVisible="False"/>
  <DockPanel x:Name="Shell" Margin="28">
    <DockPanel.LayoutTransform><ScaleTransform x:Name="AppTransform"/></DockPanel.LayoutTransform>
    <StackPanel DockPanel.Dock="Top">
      <DockPanel Margin="0,0,0,24">
        <Border DockPanel.Dock="Left" Background="#53D9B0" CornerRadius="12" Width="58" Height="58" Margin="0,0,16,0"><TextBlock Text="T⁴" FontSize="30" FontWeight="Bold" Foreground="#10231E" HorizontalAlignment="Center"/></Border>
        <StackPanel><TextBlock Text="Tommy’s Time Tracking Tables" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Make room for every moment." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
      </DockPanel>
      <WrapPanel Margin="0,0,0,18">
        <Button Content="＋  Add timer" Background="#53D9B0" Foreground="#10231E" Click="Add_Click"/>
        <Button Content="Export…" Click="Export_Click"/>
        <Button Content="Save now" Click="Save_Click"/>
        <Button Content="Load saved…" Click="Load_Click"/>
        <Button Content="Settings" Click="Settings_Click"/>
        <Button Content="Appearance…" Click="Appearance_Click"/>
        <Button Content="Backups…" Click="Backups_Click"/>
      </WrapPanel>
      <Border Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="16" Margin="0,0,0,24">
        <WrapPanel VerticalAlignment="Center">
          <TextBlock Text="App scale" Margin="0,0,10,0"/><Slider x:Name="AppSlider" AutomationProperties.Name="App scale" Minimum="0.65" Maximum="1.6" Value="1" Width="110" VerticalAlignment="Center" ValueChanged="Scale_Changed"/><TextBlock x:Name="AppPercent" Text="100%" Width="48" Margin="8,0,0,0"/><Button Content="↺" ToolTip="Reset app scale" AutomationProperties.Name="Reset app scale" Click="ResetApp_Click" Padding="8,4"/>
          <TextBlock Text="Timer scale" Margin="14,0,10,0"/><Slider x:Name="TimerSlider" AutomationProperties.Name="Timer scale" Minimum="0.6" Maximum="1.8" Value="1" Width="110" VerticalAlignment="Center" ValueChanged="Scale_Changed"/><TextBlock x:Name="TimerPercent" Text="100%" Width="48" Margin="8,0,0,0"/><Button Content="↺" ToolTip="Reset timer scale" AutomationProperties.Name="Reset timer scale" Click="ResetTimer_Click" Padding="8,4"/>
          <Button x:Name="LayoutButton" Content="Switch to list" Click="Layout_Click" Padding="10,5" Margin="16,0,0,0"/>
        </WrapPanel>
      </Border>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><TextBlock x:Name="Status" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></DockPanel>
    <ScrollViewer x:Name="WorkspaceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Workspace_SizeChanged">
      <StackPanel>
        <TextBlock x:Name="EmptyState" Text="Your workspace is ready. Add your first timer to begin." Foreground="{StaticResource Muted}" FontSize="18" Margin="8,36"/>
        <local:TimerGridPanel x:Name="Cards" HorizontalAlignment="Left" VerticalAlignment="Top"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
  </Grid>
</Window>
