<Window x:Class="TimersApp.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TimersApp.Desktop" Style="{StaticResource {x:Type Window}}" Title="T⁴" Width="1220" Height="820" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterScreen" Icon="Resources/T4.ico">
<Grid x:Name="Root">
<local:ImageBackdrop x:Name="AppBackdrop" IsHitTestVisible="False"/>
<DockPanel x:Name="Shell" Margin="16">
<DockPanel.LayoutTransform><ScaleTransform x:Name="AppTransform"/></DockPanel.LayoutTransform>
<ScrollViewer x:Name="ToolbarScroll" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" MaxHeight="260" Margin="0,0,0,6" ScrollChanged="Toolbar_ScrollChanged">
<Grid x:Name="Toolbar" HorizontalAlignment="Left" SizeChanged="Toolbar_SizeChanged">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Button x:Name="AddTimerButton" Background="{DynamicResource Accent}" Padding="12" Margin="0,0,6,0" ToolTip="Add timer" AutomationProperties.Name="Add timer" Click="Add_Click"><local:ToolbarIcon Kind="AddTimer" Width="32" Height="32"/></Button>
<Grid x:Name="ToolbarCenter" Grid.Column="1" MinWidth="438">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,4">
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,6,0"><TextBlock Text="Workspace style" FontSize="11" Foreground="{StaticResource Muted}"/><ComboBox x:Name="WorkspacePicker" MinWidth="170" Height="30" Padding="5,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="Black" DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="Saved workspaces" AutomationProperties.Name="Saved workspaces" SelectionChanged="Workspace_Selected"/></StackPanel>
<Button Grid.Column="1" ToolTip="New workspace" AutomationProperties.Name="New workspace" Click="NewWorkspace_Click" Padding="9" Margin="0,12,4,0"><local:ToolbarIcon Kind="Plus"/></Button>
<Button Grid.Column="2" ToolTip="Save workspace" AutomationProperties.Name="Save workspace" Click="Save_Click" Padding="9" Margin="0,12,4,0"><local:ToolbarIcon Kind="Save"/></Button>
<Button Grid.Column="3" ToolTip="Rename workspace" AutomationProperties.Name="Rename workspace" Click="RenameWorkspace_Click" Padding="9" Margin="0,12,4,0"><local:ToolbarIcon Kind="Rename"/></Button>
<Button Grid.Column="4" ToolTip="Duplicate workspace" AutomationProperties.Name="Duplicate workspace" Click="DuplicateWorkspace_Click" Padding="9" Margin="0,12,4,0"><local:ToolbarIcon Kind="Copy"/></Button>
<Button Grid.Column="5" x:Name="DeleteWorkspaceButton" ToolTip="Delete workspace" AutomationProperties.Name="Delete workspace" Click="DeleteWorkspace_Click" Padding="9" Margin="0,12,0,0"><local:ToolbarIcon Kind="Delete"/></Button>
</Grid>
<UniformGrid x:Name="CommandButtons" Grid.Row="1" Columns="4"><UniformGrid.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,9"/><Setter Property="Margin" Value="0"/></Style></UniformGrid.Resources><Button Content="Export" Click="Export_Click"/><Button Content="Settings" Click="Settings_Click"/><Button Content="Appearance" Click="Appearance_Click"/><Button Content="Backups" Click="Backups_Click"/></UniformGrid>
</Grid>
<StackPanel x:Name="ToolbarSquares" Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
<Button x:Name="LayoutButton" Click="Layout_Click" Width="{Binding ActualHeight, ElementName=ToolbarCenter}" Height="{Binding ActualHeight, ElementName=ToolbarCenter}" Padding="4" Margin="0,0,4,0"><StackPanel><local:ToolbarIcon x:Name="LayoutIcon" Kind="List" Width="28" Height="28" HorizontalAlignment="Center"/><TextBlock x:Name="LayoutLabel" Text="List view" TextAlignment="Center" FontSize="12" Margin="0,4,0,0"/></StackPanel></Button>
<Button x:Name="SizeButton" Click="Size_Click" Width="{Binding ActualHeight, ElementName=ToolbarCenter}" Height="{Binding ActualHeight, ElementName=ToolbarCenter}" Padding="4" Margin="0" ToolTip="Timer and default pop-out sizes" AutomationProperties.Name="Timer size"><StackPanel><local:ToolbarIcon Kind="GrowClock" Width="28" Height="28" HorizontalAlignment="Center"/><TextBlock Text="Timer size" TextAlignment="Center" FontSize="12" Margin="0,4,0,0"/></StackPanel></Button>
</StackPanel></Grid></ScrollViewer>
<Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="0,2" Visibility="Collapsed"><TextBlock x:Name="Status" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Border>
<ScrollViewer x:Name="WorkspaceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Workspace_SizeChanged" ScrollChanged="Workspace_ScrollChanged">
<StackPanel><TextBlock x:Name="EmptyState" Text="Your workspace is ready. Add your first timer to begin." Foreground="{StaticResource Muted}" FontSize="18" Margin="8,36" TextWrapping="Wrap"/><local:TimerGridPanel x:Name="Cards" HorizontalAlignment="Left" VerticalAlignment="Top"/></StackPanel>
</ScrollViewer>
</DockPanel>
<Grid x:Name="SizeOverlay" Visibility="Collapsed" Background="#60000000" KeyboardNavigation.TabNavigation="Cycle" PreviewMouseDown="SizeOverlay_MouseDown" PreviewKeyDown="SizeOverlay_KeyDown">
<Border x:Name="SizePanel" Background="{StaticResource PanelBackground}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Padding="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel>
<DockPanel><Button DockPanel.Dock="Right" Content="×" Click="CloseSize_Click" ToolTip="Close size panel" AutomationProperties.Name="Close size panel" Padding="8,2" Margin="8,0,0,0"/><TextBlock Text="Timer sizes" FontWeight="SemiBold"/></DockPanel>
<TextBlock Text="Timer size" Margin="0,8,0,0"/><local:ScaleInput x:Name="TimerScaleInput" Label="Timer size percent"/>
<CheckBox x:Name="LinkSize" Content="Link sizes" ToolTip="Link default pop-out size to timer size" AutomationProperties.Name="Link default pop-out size to timer size" Checked="LinkSize_Changed" Unchecked="LinkSize_Changed"/>
<TextBlock Text="Default pop-out size"/><local:ScaleInput x:Name="PopoutScaleInput" Label="Default pop-out size percent"/>
<TextBlock Text="Used when size memory is off or empty. The first opening saves its size when memory is on. Open windows keep their size." MaxWidth="290" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Muted}"/>
</StackPanel></ScrollViewer></Border></Grid>
<Button x:Name="ResetZoom" Content="Reset app size" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Click="ResetZoom_Click"/>
<Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Background="#293B55" CornerRadius="8" Padding="16,10" Margin="12"><DockPanel><Button x:Name="ToastDismiss" DockPanel.Dock="Right" Content="×" ToolTip="Dismiss notification" AutomationProperties.Name="Dismiss notification" Padding="8,2" Margin="12,0,0,0" Click="DismissToast_Click"/><TextBlock x:Name="ToastText" AutomationProperties.LiveSetting="Assertive" Text="Saved" FontSize="16" TextWrapping="Wrap" MaxWidth="400"/></DockPanel></Border>
</Grid></Window>
