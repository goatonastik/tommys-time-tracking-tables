<Application x:Class="TimersApp.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ControlTemplate x:Key="TimerResizeTemplate" TargetType="Thumb"><TextBlock Text="◢" Foreground="#7286A3" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></ControlTemplate>
    <SolidColorBrush x:Key="WindowBackground" Color="#0E1525"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#182338"/>
    <SolidColorBrush x:Key="Muted" Color="#AAB9CF"/>
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource WindowBackground}"/><Setter Property="Foreground" Value="#EDF3FD"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#293B55"/><Setter Property="Foreground" Value="#EDF3FD"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#24334C"/><Setter Property="Foreground" Value="#EDF3FD"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="9"/><Setter Property="BorderBrush" Value="#465A78"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF3FD"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#172033"/></Style>
  </Application.Resources>
</Application>
